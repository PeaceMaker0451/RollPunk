[node name="UpdateLog" type="RichTextLabel" parent="Background/Menu/RightContent/MarginContainer/ScrollContainer/VBoxContainer/PanelContainer2" unique_id=1622916374]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 0
bbcode_enabled = true
text = "(пример текста обновлений)
[url={link}][b]RollPunk 0.5.1[/b][/url]
- исправлены ошибки в сериализации и десериализации полей сущностей, и правил, из-за которых терялись данные, необходимые для обработки событий, вызываемыми кнопками
- исправлена ошибка, из-за которой в текстовые поля нельзя было вставлять текст
- изменен механизм загрузки файлов сущностей - теперь сущности \"клонируются\" с файла, то есть, теперь можно загружать несколько копий одной сущности
- хранение полей переписано таким образом, чтобы в древе наследования не могло быть нескольких полей с одинаковыми названиями

Набор КП правил
- добавлен автоматический апгрейд файлов персонажей до актуальной версии
- при апгрейде файлов персонажей автоматически будет восстановлен функционал кнопок действий"
fit_content = true

